# Leave unset to run in DEMO MODE (seeded PRs, scripted agent runs, no network).
# Set both to run against a real sandbox repo with real Claude agents.

# Anthropic API key for the Claude agents
ANTHROPIC_API_KEY=

# GitHub token with repo + actions scope for the sandbox demo repo
GITHUB_TOKEN=

# Target sandbox repo the dashboard operates on
GITHUB_OWNER=
GITHUB_REPO=

# Claude model used by the agents
ANTHROPIC_MODEL=claude-sonnet-4-5
